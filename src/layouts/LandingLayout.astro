---
import '../styles/global.css';
import WhatsAppWidget from '../components/WhatsAppWidget.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Obtenez un devis rapide avec CARPS INTERNATIONAL IARD." } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/assets/logo/logo-white.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="flex flex-col min-h-screen bg-corporate-light">
		<header class="bg-white border-b border-gray-200 py-4 shadow-sm sticky top-0 z-50">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex justify-between items-center">
				<a href="/" class="flex-shrink-0 flex items-center" aria-label="Retour à l'accueil">
					<img src="/assets/logo/logo-color.png" alt="CARPS IARD" class="h-12 w-auto object-contain transition-transform hover:scale-105 duration-300" />
				</a>
				<div class="flex items-center gap-4">
					<a href="tel:+33601785792" class="text-corporate-dark font-medium hidden sm:block">
						+33 6 01 78 57 92
					</a>
					<a href="https://wa.me/33601785792" target="_blank" rel="noopener noreferrer" class="text-green-500 hover:text-green-600">
						<svg width="28" height="28" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
							<path d="M16.002 0h-.006c-8.837 0-16.002 7.163-16.002 16.001 0 2.825.733 5.565 2.128 7.994l-2.122 7.747 7.933-2.079c2.348 1.258 5 1.916 7.712 1.916h.005c8.836 0 16.002-7.165 16.002-16.002 0-8.838-7.166-16.001-16.001-16.001v.024zm0 29.176h-.004c-2.385 0-4.721-.64-6.772-1.854l-.485-.292-5.029 1.318 1.341-4.903-.322-.511c-1.328-2.107-2.03-4.545-2.03-7.07 0-7.327 5.961-13.287 13.291-13.287 3.548 0 6.883 1.384 9.394 3.894 2.51 2.511 3.892 5.848 3.892 9.397 0 7.323-5.961 13.283-13.283 13.283v.025zm7.291-9.948c-.4-.2-2.368-1.168-2.735-1.303-.367-.133-.634-.201-.9.201-.267.401-1.034 1.302-1.267 1.569-.234.267-.468.301-.868.101-1.748-.871-3.136-1.821-4.321-3.805-.306-.513.303-.473.882-1.634.133-.268.067-.502-.034-.702-.1-.2-.9-2.172-1.233-2.973-.323-.777-.652-.673-.9-.684-.233-.012-.5-.015-.768-.015-.268 0-.701.101-1.068.502-.368.4-1.402 1.371-1.402 3.342 0 1.972 1.436 3.877 1.636 4.144.201.267 2.825 4.315 6.845 6.049.957.412 1.704.658 2.287.842 1.05.334 2.006.287 2.763.174.843-.126 2.368-.969 2.701-1.905.334-.937.334-1.742.234-1.906-.1-.17-.367-.27-.768-.47v-.004z" />
						</svg>
					</a>
				</div>
			</div>
		</header>

		<main class="flex-grow flex items-center justify-center py-12 px-4 sm:px-6">
			<slot />
		</main>

		<footer class="bg-corporate-dark text-white py-6 text-center text-sm">
			<div class="max-w-7xl mx-auto px-4">
				<p>&copy; {new Date().getFullYear()} CARPS INTERNATIONAL IARD. <a href="/mentions-legales" class="underline hover:text-gray-300">Mentions Légales</a></p>
			</div>
		</footer>

		<WhatsAppWidget />
	</body>
</html>

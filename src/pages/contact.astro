---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact | CARPS IARD">
  <section class="section-padding max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h1 class="text-4xl font-heading font-bold mb-6 text-corporate-dark">Nous contacter</h1>
        <p class="text-lg text-corporate-gray mb-8">Notre équipe est à votre disposition pour toute demande de devis, d'information ou d'accompagnement.</p>
        
        <div class="space-y-6">
          <div class="flex items-start">
            <svg class="w-6 h-6 text-corporate-blue mt-1 mr-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <div>
              <h3 class="font-bold text-corporate-dark">Agence Paris</h3>
              <p class="text-gray-600">168 rue de Grenelle<br/>75007 Paris</p>
            </div>
          </div>
          
          <div class="flex items-start">
            <svg class="w-6 h-6 text-corporate-blue mt-1 mr-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
            <div>
              <h3 class="font-bold text-corporate-dark">Téléphone</h3>
              <p><a href="tel:+33601785792" class="text-gray-600 hover:text-corporate-blue">+33 6 01 78 57 92</a></p>
            </div>
          </div>

          <div class="flex items-start">
            <svg class="w-6 h-6 text-[#25D366] mt-1 mr-4" fill="currentColor" viewBox="0 0 32 32"><path d="M16.002 0h-.006c-8.837 0-16.002 7.163-16.002 16.001 0 2.825.733 5.565 2.128 7.994l-2.122 7.747 7.933-2.079c2.348 1.258 5 1.916 7.712 1.916h.005c8.836 0 16.002-7.165 16.002-16.002 0-8.838-7.166-16.001-16.001-16.001v.024zm0 29.176h-.004c-2.385 0-4.721-.64-6.772-1.854l-.485-.292-5.029 1.318 1.341-4.903-.322-.511c-1.328-2.107-2.03-4.545-2.03-7.07 0-7.327 5.961-13.287 13.291-13.287 3.548 0 6.883 1.384 9.394 3.894 2.51 2.511 3.892 5.848 3.892 9.397 0 7.323-5.961 13.283-13.283 13.283v.025z"/></svg>
            <div>
              <h3 class="font-bold text-corporate-dark">WhatsApp</h3>
              <p><a href="https://wa.me/33601785792" class="text-gray-600 hover:text-green-600">+33 6 01 78 57 92</a></p>
            </div>
          </div>
          
          <div class="flex items-start">
            <svg class="w-6 h-6 text-corporate-blue mt-1 mr-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            <div>
              <h3 class="font-bold text-corporate-dark">Email</h3>
              <p><a href="mailto:smaamar@carps.fr" class="text-gray-600 hover:text-corporate-blue">smaamar@carps.fr</a></p>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white p-8 rounded-lg shadow-sm border border-gray-100">
        <h3 class="text-2xl font-bold mb-6 text-corporate-dark font-heading">Formulaire de contact</h3>
        <form action="/merci-auto" method="GET" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-corporate-dark mb-1">Nom & Prénom</label>
            <input type="text" required class="w-full px-4 py-2 bg-corporate-light border border-gray-200 rounded-md" />
          </div>
          <div>
            <label class="block text-sm font-medium text-corporate-dark mb-1">Téléphone</label>
            <input type="tel" required class="w-full px-4 py-2 bg-corporate-light border border-gray-200 rounded-md" />
          </div>
          <div>
            <label class="block text-sm font-medium text-corporate-dark mb-1">Email</label>
            <input type="email" required class="w-full px-4 py-2 bg-corporate-light border border-gray-200 rounded-md" />
          </div>
          <div>
            <label class="block text-sm font-medium text-corporate-dark mb-1">Votre message</label>
            <textarea rows="4" required class="w-full px-4 py-2 bg-corporate-light border border-gray-200 rounded-md"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full">Envoyer</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

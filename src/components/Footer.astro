---
// src/components/Footer.astro
const year = new Date().getFullYear();
---

<footer class="bg-corporate-dark text-white pt-16 pb-8 border-t border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <!-- Brand & Info -->
      <div class="md:col-span-1">
        <img src="/assets/logo/logo-white.svg" alt="CARPS IARD" class="h-10 w-auto mb-6" />
        <address class="not-italic text-gray-400 mb-6 space-y-1">
          168 Rue de Grenelle<br />
          75007 Paris<br />
          France
        </address>
        <div class="space-y-3">
          <a href="tel:+33601785792" class="flex items-center text-gray-300 hover:text-gold transition-colors">
            <svg class="w-5 h-5 mr-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            +33 6 01 78 57 92
          </a>
          <a href="mailto:smaamar@carps.fr" class="flex items-center text-gray-300 hover:text-gold transition-colors">
            <svg class="w-5 h-5 mr-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            smaamar@carps.fr
          </a>
        </div>
      </div>

      <!-- Navigation -->
      <div>
        <h3 class="text-gold font-bold uppercase tracking-wider text-sm mb-6">Navigation</h3>
        <ul class="space-y-3">
          <li><a href="/assurance-auto" class="text-gray-400 hover:text-gold transition-colors">Assurance Auto</a></li>
          <li><a href="/assurance-habitation" class="text-gray-400 hover:text-gold transition-colors">Assurance Habitation</a></li>
          <li><a href="/mrp" class="text-gray-400 hover:text-gold transition-colors">Multirisque Pro (MRP)</a></li>
          <li><a href="/qui-sommes-nous" class="text-gray-400 hover:text-gold transition-colors">Qui sommes-nous</a></li>
        </ul>
      </div>

      <!-- Informations légales -->
      <div>
        <h3 class="text-gold font-bold uppercase tracking-wider text-sm mb-6">Informations légales</h3>
        <ul class="space-y-3">
          <li><a href="/mentions-legales" class="text-gray-400 hover:text-gold transition-colors">Mentions légales</a></li>
          <li><a href="/politique-de-confidentialite" class="text-gray-400 hover:text-gold transition-colors">Politique de confidentialité</a></li>
          <li><a href="/actualites" class="text-gray-400 hover:text-gold transition-colors">Actualités & Conseils</a></li>
        </ul>
      </div>

      <!-- CTA -->
      <div class="bg-gray-800/50 p-6 rounded-lg border border-gray-700/50">
        <h3 class="text-white font-bold text-lg mb-2">Prêt à être protégé ?</h3>
        <p class="text-gray-400 text-sm mb-6">Demandez votre devis gratuit en ligne. Réponse en moins de 24h.</p>
        <a href="/contact" class="btn btn--gold w-full text-center py-3 rounded-md font-bold transition-transform hover:-translate-y-1 block">Demander un Devis</a>
      </div>
    </div>

    <!-- Bottom -->
    <div class="border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center text-sm text-gray-500">
      <p>&copy; {year} CARPS INTERNATIONAL IARD. Tous droits réservés.</p>
      <div class="mt-4 md:mt-0 space-x-4">
        <a href="/mentions-legales" class="hover:text-gold transition-colors">Mentions légales</a>
        <span>•</span>
        <a href="/politique-de-confidentialite" class="hover:text-gold transition-colors">Confidentialité</a>
      </div>
    </div>
  </div>
</footer>

            <li><a href="#global-presence" class="navbar__link" onClick={handleSmoothScroll}>[CONTENT]</a></li>
            <li><a href="#contact" class="navbar__link" onClick={handleSmoothScroll}>[CONTENT]</a></li>
          </ul>
        </nav>

        <div class="navbar__actions">
          <LanguageSwitcher />
          <a href="#contact" class="btn btn--gold navbar__cta" onClick={handleSmoothScroll}>[CONTENT]</a>
        </div>

        <button 

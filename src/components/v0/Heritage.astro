---
// Converted from Heritage.jsx
---

    <section class='heritage' aria-labelledby='heritage-heading'>
      <div class='heritage__bg-text' aria-hidden='true'>1974</div>
      <div class='container'>
        <div class='heritage__content'>
          <span class='section-label'>[CONTENT]</span>
          <h2 class='section-title' id='heritage-heading' style={{whiteSpace: 'pre-line'}}>[CONTENT]</h2>
          <div class='heritage__gold-line' aria-hidden='true' />
          <div class='heritage__body' style={{display: 'flex', gap: '48px', alignItems: 'center', marginTop: '32px'}}>
            <div class='heritage__text-col' style={{flex: '1'}}>
              <p class='heritage__text'>[CONTENT]</p>
              <p class='heritage__text'>[CONTENT]</p>
              <a href='#contact' class='btn btn--gold'>[CONTENT] <span aria-hidden='true'>→</span></a>
            </div>
            <div class='heritage__image-col' style={{flex: '0 0 360px'}}>
              <img src={heritageImage} alt='Historic Parisian building entrance' loading='lazy' class='heritage__image' style={{borderRadius: '8px', width: '100%', maxWidth: '360px', objectFit: 'cover'}} />
            </div>
          </div>
        </div>
      </div>
    </section>
  

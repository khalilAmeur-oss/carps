---
// Converted from QuoteForm.jsx
---

    <div class={`quote-card ${variant === 'section' ? 'quote-card--section' : ''}`}>
      {status !== 'success' && (
        <>
          <div class="quote-card__header">
            <h2 class="quote-card__title">[CONTENT]</h2>
            <p class="quote-card__subtitle">[CONTENT]</p>
          </div>
          
          <form class="quote-form" id={`${formId}QuoteForm`} noValidate onSubmit={handleSubmit}>
            <div class="quote-form__row">
              <div class="quote-form__field">
                <label for={`${formId}-firstName`} class="quote-form__label">[CONTENT] <span class="required">*</span></label>
                <input 
                  type="text" 
                  id={`${formId}-firstName`} 
                  name="firstName" 
                  class={`quote-form__input ${errors.firstName ? 'error' : ''}`} 
                  required 
                  value={formData.firstName} 
                  onChange={handleChange} 
                  placeholder=[CONTENT] 
                  autoComplete="given-name" 
                />
                {errors.firstName && <span class="quote-form__error visible" role="alert">{errors.firstName}</span>}
              </div>
              
              <div class="quote-form__field">
                <label for={`${formId}-lastName`} class="quote-form__label">[CONTENT] <span class="required">*</span></label>
                <input 
                  type="text" 
                  id={`${formId}-lastName`} 
                  name="lastName" 
                  class={`quote-form__input ${errors.lastName ? 'error' : ''}`} 
                  required 
                  value={formData.lastName} 
                  onChange={handleChange} 
                  placeholder=[CONTENT] 
                  autoComplete="family-name" 
                />
                {errors.lastName && <span class="quote-form__error visible" role="alert">{errors.lastName}</span>}
              </div>
            </div>

            <div class="quote-form__field">
              <label for={`${formId}-email`} class="quote-form__label">[CONTENT] <span class="required">*</span></label>
              <input 
                type="email" 
                id={`${formId}-email`} 
                name="email" 
                class={`quote-form__input ${errors.email ? 'error' : ''}`} 
                required 
                value={formData.email} 
                onChange={handleChange} 
                placeholder=[CONTENT] 
                autoComplete="email" 
              />
              {errors.email && <span class="quote-form__error visible" role="alert">{errors.email}</span>}
            </div>

            <div class="quote-form__field">
              <label for={`${formId}-phone`} class="quote-form__label">[CONTENT] <span class="required">*</span></label>
              <input 
                type="tel" 
                id={`${formId}-phone`} 
                name="phone" 
                class={`quote-form__input ${errors.phone ? 'error' : ''}`} 
                required 
                value={formData.phone} 
                onChange={handleChange} 
                placeholder=[CONTENT] 
                autoComplete="tel" 
              />
              {errors.phone && <span class="quote-form__error visible" role="alert">{errors.phone}</span>}
            </div>

            <div class="quote-form__field">
              <label for={`${formId}-profile`} class="quote-form__label">[CONTENT] <span class="required">*</span></label>
              <select 
                id={`${formId}-profile`} 
                name="profile" 
                class={`quote-form__select ${errors.profile ? 'error' : ''}`} 
                required 
                value={formData.profile} 
                onChange={handleChange}
              >
                <option value="" disabled>[CONTENT]</option>
                <option value="diplomat">[CONTENT]</option>
                <option value="embassy">[CONTENT]</option>
                <option value="expatriate">[CONTENT]</option>
                <option value="company">[CONTENT]</option>
              </select>
              {errors.profile && <span class="quote-form__error visible" role="alert">{errors.profile}</span>}
            </div>

            <div class="quote-form__field">
              <label for={`${formId}-country`} class="quote-form__label">[CONTENT] <span class="required">*</span></label>
              <input 
                type="text" 
                id={`${formId}-country`} 
                name="country" 
                class={`quote-form__input ${errors.country ? 'error' : ''}`} 
                required 
                value={formData.country} 
                onChange={handleChange} 
                placeholder=[CONTENT] 
              />
              {errors.country && <span class="quote-form__error visible" role="alert">{errors.country}</span>}
            </div>

            <button 
              type="submit" 
              class={`btn btn--gold btn--full quote-form__submit ${status === 'loading' ? 'loading' : ''}`} 
              disabled={status === 'loading'}
            >
              <span class="quote-form__submit-text">[CONTENT] →</span>
              <span class="quote-form__submit-loading" aria-hidden={status !== 'loading'}>[CONTENT]</span>
            </button>
            
            <p class="quote-form__disclaimer">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{marginRight: '6px', verticalAlign: 'middle'}}>
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              [CONTENT]
            </p>
          </form>
        </>
      )}
      
      {status === 'success' && (
        <div class="quote-card__success">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#b08b57" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" style={{marginBottom: '1rem'}}>
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
          <h3 class="quote-card__success-title">[CONTENT]</h3>
          <p class="quote-card__success-text">[CONTENT]</p>
        </div>
      )}
    </div>
  

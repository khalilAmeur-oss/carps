---
// src/components/Header.astro
const currentPath = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/assurance-auto', label: 'Assurance Auto' },
  { href: '/assurance-habitation', label: 'Assurance Habitation' },
  { href: '/mrp', label: 'Multirisque Pro' },
  { href: '/qui-sommes-nous', label: 'Qui sommes-nous' },
];
---

<header id="main-header" class="fixed w-full z-50 transition-all duration-300 bg-corporate-dark/95 backdrop-blur-md shadow-md h-20 text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full">
    <div class="flex justify-between items-center h-full">
      <!-- Logo -->
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="flex items-center group">
          <img src="/assets/logo/logo-white.svg" alt="CARPS IARD" class="h-10 w-auto object-contain transition-transform group-hover:scale-105 duration-300" />
        </a>
      </div>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex space-x-8 items-center">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`nav-link inline-flex items-center px-1 py-2 text-sm font-medium transition-colors duration-200 ${
              currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                ? 'active text-gold'
                : 'text-gray-300 hover:text-gold'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA & Contact -->
      <div class="hidden md:flex items-center space-x-6">
        <div class="flex items-center text-white font-medium">
          <svg class="w-5 h-5 mr-2 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          <a href="tel:+33601785792" class="hover:text-gold transition-colors">+33 6 01 78 57 92</a>
        </div>
        <a href="/contact" class="btn btn--gold btn--sm font-bold px-6 py-2 rounded-md transition-transform hover:scale-105">Obtenir un devis</a>
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center md:hidden">
        <button type="button" id="mobile-menu-btn" class="inline-flex items-center justify-center p-2 rounded-md text-corporate-gray hover:text-corporate-blue hover:bg-gray-100 focus:outline-none">
          <span class="sr-only">Ouvrir le menu principal</span>
          <svg class="block h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="md:hidden hidden" id="mobile-menu">
    <div class="px-2 pt-2 pb-3 space-y-1 bg-white shadow-lg">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`block px-3 py-2 rounded-md text-base font-medium ${
            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
              ? 'bg-blue-50 text-corporate-blue'
              : 'text-corporate-dark hover:bg-gray-50 hover:text-corporate-blue'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a href="/contact" class="block w-full text-center mt-4 btn-primary">
        Obtenir un devis
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  }
</script>
